# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack dashboard -> Settings -> API Keys & Webhooks
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Used to build absolute callback/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upstash Redis (console.upstash.com) -> used for rate limiting auth and
# checkout endpoints. If unset, rate limiting is disabled (fail-open) with a
# console warning - fine for local dev, must be set in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google Analytics 4 measurement ID (starts with "G-"). Leave blank to skip GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
